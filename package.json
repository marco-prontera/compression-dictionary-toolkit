{
    "name": "compression-dictionary-toolkit",
    "version": "0.2.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "doctor": "node scripts/doctor.mjs",
        "test": "node --test test/*.test.mjs",
        "test:browser": "node scripts/browser-test.mjs",
        "demo:build": "node playground/product/build.mjs",
        "demo:serve": "node playground/server.mjs",
        "demo:inspect": "node scripts/inspect.mjs",
        "demo:cycle": "node scripts/demo-cycle.mjs",
        "demo:export": "node scripts/export-demo.mjs",
        "check:deployment": "node scripts/check-deployment.mjs",
        "check:types": "tsc -p test/tsconfig.json",
        "check:packages": "node scripts/check-packages.mjs",
        "pack:release": "node scripts/check-packages.mjs --out-dir artifacts/npm",
        "benchmark": "node scripts/benchmark.mjs",
        "demo": "node playground/start.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.0.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "playwright": "1.64.1",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0",
        "vite": "8.3.5"
    },
    "license": "MIT",
    "author": "Marco Prontera",
    "description": "Build and serve shared HTTP compression dictionaries with core APIs, a Vite plugin, and Node/edge handlers",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/marco-prontera/compression-dictionary-toolkit.git"
    },
    "homepage": "https://github.com/marco-prontera/compression-dictionary-toolkit#readme",
    "bugs": {
        "url": "https://github.com/marco-prontera/compression-dictionary-toolkit/issues"
    },
    "exports": {
        ".": {
            "types": "./src/core/index.d.ts",
            "import": "./src/core/index.js"
        },
        "./vite": {
            "types": "./src/vite/index.d.ts",
            "import": "./src/vite/index.js"
        },
        "./server": {
            "types": "./src/server/index.d.ts",
            "import": "./src/server/index.js"
        },
        "./edge": {
            "types": "./src/server/edge.d.ts",
            "import": "./src/server/edge.js"
        }
    },
    "bin": {
        "shared-dict": "./src/core/cli.js"
    },
    "files": [
        "src",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "peerDependencies": {
        "vite": "^7.0.0 || ^8.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "keywords": [
        "compression-dictionary",
        "vite-plugin",
        "dcb",
        "dcz"
    ]
}
